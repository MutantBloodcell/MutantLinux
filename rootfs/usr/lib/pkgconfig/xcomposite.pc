prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Xcomposite
Description: X Composite Extension Library
URL: https://gitlab.freedesktop.org/xorg/lib/libxcomposite/
Version: 0.4.7
Requires: xproto >=  7.0.22, compositeproto >= 0.4
Requires.private: x11, xfixes
Libs: -L${libdir} -lXcomposite
Cflags: -I${includedir}
