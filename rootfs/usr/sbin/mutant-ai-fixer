#!/bin/sh
# MutantLinux AI Autonomous Web-Connected Thinking & Self-Healing Daemon

. /etc/mutantd/ai.conf 2>/dev/null
. /etc/mutantd/firebase.conf 2>/dev/null

STATE_DIR="/run/mutantd/aifixer"
LOG_FILE="/var/log/mutantd/ai-fixer.log"
mkdir -p "$STATE_DIR" /var/log/mutantd /tmp/.X11-unix /run/dbus
chmod 1777 /tmp /tmp/.X11-unix

HOST=$(cat /etc/hostname 2>/dev/null || echo "mutant-arm64")
MID=$(cat /etc/machine-id 2>/dev/null || echo "unknown")

log_ai() {
    LEVEL="$1"
    MSG="$2"
    TS=$(date +"%H:%M:%S")
    LINE="[AI-FIXER $TS] [$LEVEL] $MSG"
    echo "$LINE" >> "$LOG_FILE"
    printf '\r\033[1;36m%s\033[0m\n' "$LINE" > /dev/tty3 2>/dev/null

    if [ "$TELEMETRY_ENABLED" = "1" ] && [ -n "$FIREBASE_DB_URL" ]; then
        CLEAN_MSG=$(printf '%s' "$MSG" | tr '"' "'" | tr '\n' ' ' | cut -c 1-350)
        UTC=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        PAYLOAD="{\"host\":\"${HOST}\",\"level\":\"${LEVEL}\",\"message\":\"${CLEAN_MSG}\",\"timestamp\":\"${UTC}\"}"
        curl -s -X POST -H "Content-Type: application/json" -d "$PAYLOAD" \
            "${FIREBASE_DB_URL}/autofix/${MID}.json" >/dev/null 2>&1 &
    fi
}

# Grab troubleshooting context directly from the internet
web_research() {
    RAW_ERR="$1"
    # Build URL-encoded search query from key error words
    QUERY=$(printf 'alpine linux arm64 %s' "$RAW_ERR" | tr -cd '[:alnum:] ._-' | cut -c 1-90 | sed 's/ /+/g')
    log_ai "WEB-SEARCH" "Searching web for: $QUERY"

    DDG_SUB="html"
    DDG_DOM="duckduckgo.com"
    HTML=$(curl -s --max-time 10 -A "Mozilla/5.0" "https://${DDG_SUB}.${DDG_DOM}/html/?q=${QUERY}")

    SNIPPETS=$(printf '%s' "$HTML" | grep -o 'class="result__snippet"[^>]*>[^<]*' | sed 's/.*>//g' | head -n 3 | tr '\n' ' ' | cut -c 1-450)
    [ -z "$SNIPPETS" ] && SNIPPETS="No external web snippets returned."
    printf '%s' "$SNIPPETS"
}

# Fast built-in offline fallback repairs
offline_think_and_fix() {
    ERR_TEXT="$1"

    if [ ! -s /etc/machine-id ]; then
        log_ai "THOUGHT" "D-Bus and KDE require /etc/machine-id, which is missing."
        cat /proc/sys/kernel/random/uuid | tr -d '-' > /etc/machine-id
        mkdir -p /var/lib/dbus && cp -f /etc/machine-id /var/lib/dbus/machine-id
        log_ai "FIX" "Generated new /etc/machine-id"
    fi

    if printf '%s' "$ERR_TEXT" | grep -qE "(glamor initialization failed|open /dev/dri/card0: No such file)"; then
        if ! grep -q "AutoFix Safe 2D" /etc/X11/xorg.conf.d/20-auto-gpu.conf 2>/dev/null; then
            log_ai "THOUGHT" "Xorg failed 3D Glamor/DRI on virtual framebuffer. Switching to safe 2D modesetting."
            cat << 'XEOF' > /etc/X11/xorg.conf.d/20-auto-gpu.conf
# AutoFix Safe 2D
Section "Module"
    Disable "glamoregl"
EndSection
Section "Device"
    Identifier "AutoFixGPU"
    Driver "modesetting"
    Option "AccelMethod" "none"
    Option "SWCursor" "true"
EndSection
XEOF
            log_ai "FIX" "Configured 20-auto-gpu.conf with AccelMethod none and disabled glamoregl"
        fi
    fi

    if ! pidof dbus-daemon >/dev/null 2>&1; then
        log_ai "THOUGHT" "System D-Bus daemon is not running; desktop IPC will fail."
        mkdir -p /run/dbus
        dbus-daemon --system --nofork --nopidfile >/dev/null 2>&1 &
        log_ai "FIX" "Restarted system dbus-daemon"
    fi
}

# Cloud LLM + Live Web Search Reasoning Engine
ai_think_and_fix() {
    ERR_SNIPPET="$1"
    [ "$AI_ENABLED" != "1" ] && return 1
    case "$AI_API_KEY" in
        ""|"YOUR_API_KEY_HERE") return 1 ;;
    esac

    WEB_INFO=$(web_research "$ERR_SNIPPET")
    SYS_INFO="Kernel: $(uname -r), RAM_free: $(free -m | awk '/Mem:/ {print $4}')MB, DRM: $(ls /dev/dri 2>/dev/null || echo none)"

    PROMPT="System: ${SYS_INFO} | Error: ${ERR_SNIPPET} | Web Search Results: ${WEB_INFO}"
    ESCAPED_PROMPT=$(printf '%s' "$PROMPT" | tr '"' "'" | tr '\n' ' ' | cut -c 1-1100)

    REQ_JSON="{\"model\":\"${AI_MODEL}\",\"temperature\":0.1,\"messages\":[{\"role\":\"system\",\"content\":\"You are mutant-ai-fixer, the autonomous web-connected OS repair agent for MutantLinux ARM64 (BusyBox + musl + apk + mutantd). Use the provided Error and Web Search Results to diagnose the exact root cause and reply in EXACTLY two lines:\nTHOUGHT: <1 short sentence diagnosing root cause>\nFIX: <1 safe POSIX sh command to fix it>\"},{\"role\":\"user\",\"content\":\"${ESCAPED_PROMPT}\"}]}"

    RESP=$(curl -s --max-time 20 -X POST "$AI_API_URL" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${AI_API_KEY}" \
        -d "$REQ_JSON")

    CONTENT=$(printf '%s' "$RESP" | sed -n 's/.*"content"[[:space:]]*:[[:space:]]*"\(.*\)".*/\1/p' | sed 's/\\n/\n/g; s/\\"/"/g')
    [ -z "$CONTENT" ] && return 1

    THOUGHT=$(printf '%s\n' "$CONTENT" | grep -i "^THOUGHT:" | head -n 1 | cut -d':' -f2-)
    FIX_CMD=$(printf '%s\n' "$CONTENT" | grep -i "^FIX:" | head -n 1 | cut -d':' -f2-)

    [ -n "$THOUGHT" ] && log_ai "THOUGHT" "$THOUGHT"

    if [ -n "$FIX_CMD" ]; then
        case "$FIX_CMD" in
            *"rm -rf /"*|*"mkfs"*|*"dd if="*|*"reboot"*)
                log_ai "BLOCKED" "Refused unsafe command: $FIX_CMD"
                return 0
                ;;
        esac
        log_ai "FIX" "Executing: $FIX_CMD"
        sh -c "$FIX_CMD" >> "$LOG_FILE" 2>&1
    fi
    return 0
}

log_ai "READY" "Web-connected mutant-ai-fixer active on MutantLinux 1.0"

while true; do
    CUR_ERRS=$(grep -iE "(\(EE\)|error|critical|segfault|fatal|cannot open|failed|bail out)" \
        /var/log/mutantde.log /var/log/Xorg.0.log /var/log/mutantd/*.log 2>/dev/null | tail -n 4)

    offline_think_and_fix "$CUR_ERRS"

    if [ -n "$CUR_ERRS" ]; then
        HASH=$(printf '%s' "$CUR_ERRS" | md5sum | cut -d' ' -f1)
        LAST_HASH=$(cat "$STATE_DIR/last_err.hash" 2>/dev/null)

        if [ "$HASH" != "$LAST_HASH" ]; then
            echo "$HASH" > "$STATE_DIR/last_err.hash"
            ai_think_and_fix "$CUR_ERRS"
        fi
    fi

    sleep 8
done
