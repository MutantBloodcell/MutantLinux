#!/bin/sh
TARGET="$1"
shift

if [ -z "$TARGET" ] || [ ! -f "$TARGET" ]; then
    echo "Usage: mutant-exec <app.mbin | pkg.deb | app.exe> [args...]"
    exit 1
fi

MAGIC_4=$(dd if="$TARGET" bs=4 count=1 2>/dev/null)
MAGIC_2=$(dd if="$TARGET" bs=2 count=1 2>/dev/null)

case "$TARGET" in
    *.mbin)
        if [ "$MAGIC_4" != "MBIN" ]; then
            echo "Error: '$TARGET' is not a genuine native .mbin executable."
            echo "Do not rename .deb or .exe files to .mbin—keep their original extension so MutantLinux uses the proper wrapper."
            exit 1
        fi
        TMP_BIN="/tmp/.mbin_$(basename "$TARGET" .mbin)_$$"
        dd if="$TARGET" of="$TMP_BIN" bs=8 skip=1 2>/dev/null
        chmod 755 "$TMP_BIN"
        "$TMP_BIN" "$@"
        RET=$?
        rm -f "$TMP_BIN"
        exit $RET
        ;;

    *.deb)
        if [ "$MAGIC_4" != "!<ar" ]; then
            echo "Error: '$TARGET' is not a valid Debian/Ubuntu .deb archive."
            exit 1
        fi
        APP_NAME=$(basename "$TARGET" .deb)
        /usr/bin/mutant-port "$TARGET" "$APP_NAME"
        SAFE_ID=$(printf '%s' "$APP_NAME" | tr '[:upper:] ' '[:lower:]-' | tr -cd '[:alnum:]-')
        exec "/usr/local/bin/${SAFE_ID}" "$@"
        ;;

    *.exe|*.EXE)
        if [ "$MAGIC_2" != "MZ" ]; then
            echo "Error: '$TARGET' is not a valid Windows .exe binary."
            exit 1
        fi
        export WINEPREFIX="/root/.wine-mutant"
        if command -v wine64 >/dev/null 2>&1; then
            exec wine64 "$TARGET" "$@"
        elif command -v wine >/dev/null 2>&1; then
            exec wine "$TARGET" "$@"
        elif command -v box64 >/dev/null 2>&1 && [ -x /opt/wine-x64/bin/wine64 ]; then
            exec box64 /opt/wine-x64/bin/wine64 "$TARGET" "$@"
        else
            echo "[MutantExec] Windows runtime (wine/box64) not installed yet. Run: mpkg install wine-box64"
            exit 1
        fi
        ;;

    *)
        exec "$TARGET" "$@"
        ;;
esac
