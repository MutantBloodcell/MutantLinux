#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mkdir -p /dev/pts /tmp/.X11-unix /run/dbus
chmod 1777 /tmp /tmp/.X11-unix
mount -t devpts none /dev/pts
/sbin/udevd --daemon 2>/dev/null; udevadm trigger 2>/dev/null; sleep 0.5; /usr/sbin/mutant-hwdetect
mount -t tmpfs -o size=256M tmpfs /root
echo 1 > /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null
/usr/sbin/anti-bounce 2>/dev/null

. /etc/os-release

# Bring up network silently
ip link set lo up 2>/dev/null
ip link set eth0 up 2>/dev/null
udhcpc -i eth0 -s /usr/share/udhcpc/default.script -q -n >/dev/null 2>&1 &
echo "nameserver 1.1.1.1" > /etc/resolv.conf

# Start Ubuntu-style Virtual Consoles on tty2 and tty3 (Ctrl+Alt+F2 / F3)
setsid /sbin/getty 38400 tty2 >/dev/tty2 2>&1 < /dev/tty2 &
setsid /sbin/getty 38400 tty3 >/dev/tty3 2>&1 < /dev/tty3 &

flush_keys() {
    sleep 0.25
    while read -t 0.1 -n 1 _ 2>/dev/null; do :; done
}

safe_read() {
    VAR=""
    while [ -z "$VAR" ]; do
        read VAR
    done
    flush_keys
    echo "$VAR"
}

read_pass() {
    stty -echo
    PASS=""
    while [ -z "$PASS" ]; do
        read PASS
    done
    stty echo
    echo "" >&2
    flush_keys
    echo "$PASS"
}

DEFAULT_MODE=$(cat /etc/mutant-mode 2>/dev/null)
clear
echo "=================================================="
echo "            WELCOME TO MUTANTLINUX 1.0            "
echo "   ${HOME_URL}"
echo "=================================================="
echo "Select Boot Mode (auto-boots in 5s):"
echo "  1. GUI Mode (MutantDE Desktop - Ctrl+Alt+F1)"
echo "  2. CLI Mode (Fast Terminal - Ctrl+Alt+F2/F3)"
echo "  3. Recovery Shell (Root Maintenance)"
echo "=================================================="
printf "Enter choice [1-3]: "
read -t 5 MODE
flush_keys
[ -z "$MODE" ] && MODE="${DEFAULT_MODE:-1}"

if [ "$MODE" = "3" ]; then
    exec /bin/sh
fi

# First-Boot Setup Wizard
if [ ! -f /etc/mutant-configured ]; then
    clear
    echo "=== MUTANTLINUX FIRST-BOOT SETUP WIZARD ==="
    printf "Set System Hostname [mutant-arm64]: "
    read HNAME
    flush_keys
    [ -z "$HNAME" ] && HNAME="mutant-arm64"
    echo "$HNAME" > /etc/hostname

    printf "Create Username: "
    NEWUSER=$(safe_read)

    adduser -D -s /bin/sh "$NEWUSER"

    while true; do
        printf "Create Password (any password allowed): "
        P1=$(read_pass)
        printf "Confirm Password: "
        P2=$(read_pass)
        if [ "$P1" = "$P2" ]; then
            printf "%s:%s\n" "$NEWUSER" "$P1" | chpasswd
            printf "root:%s\n" "$P1" | chpasswd
            break
        else
            echo "Passwords did not match. Try again."
        fi
    done

    addgroup "$NEWUSER" wheel 2>/dev/null
    [ "$MODE" = "1" ] && echo "1" > /etc/mutant-mode || echo "2" > /etc/mutant-mode
    touch /etc/mutant-configured
    echo "Setup Complete!"
    sleep 1
fi

hostname -F /etc/hostname 2>/dev/null
/sbin/mutantd >/dev/null 2>&1 &

while true; do
    CUR_MODE=$(cat /etc/mutant-mode 2>/dev/null)
    [ -n "$MODE" ] && CUR_MODE="$MODE"
    clear
    if [ "$CUR_MODE" = "1" ]; then
        /usr/bin/mutant-gui
        echo "MutantDE exited. Press Enter for CLI or wait 3s..."
        read -t 3 _
        flush_keys
        MODE="2"
    else
        echo "MutantLinux 1.0 ARM64 ($(cat /etc/hostname 2>/dev/null))"
        echo "Tip: Ctrl+Alt+F1..F3 switches TTYs | 'mutant-mode gui' starts MutantDE"
        /bin/login
    fi
done
